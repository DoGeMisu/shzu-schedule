<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 系统 SplashScreen 覆盖：白底 + 透明图标，去掉默认程序图标 -->
<resources>
    <style name="Theme.SHZUSchedule" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- 状态栏跟随页面底色（去掉品牌紫色条），运行时按 in-app 主题再同步 -->
        <item name="android:statusBarColor">@color/window_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/window_bg</item>
        <!-- 系统开屏：纯白背景，不显示程序图标 -->
        <item name="android:windowSplashScreenBackground">@color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_none</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/white</item>
    </style>
</resources>
