<?xml version="1.0" encoding="utf-8"?>
<!-- 自适应图标背景：与 logo 主体同款青绿→深绿渐变。
     前景位图自身的圆角被系统遮罩切掉时，露出的边缘与图内色调衔接。
     取色来源：logo/shzu-icon-list.svg 的 bgi1 渐变。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="#0A3A2E"
        android:startColor="#4FD8B9"
        android:type="linear" />
</shape>
