<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- 自定义背景图（最底层，切周重载页面时不会闪白） -->
    <ImageView
        android:id="@+id/bgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- 有背景图时整屏只有这一张照片：状态栏、内容、手势条后面都是同一张图，
         上面不再叠任何渐变遮罩。
         曾经在顶部有 topScrim、底部有 bottomCover（页面盖住课表时给手势条
         区域垫一块页面色），结果顶部露照片、底部垫实色，两边颜色永远对不上；
         bottomCover 那块在深色主题下看起来就是「一条由透明到黑的阴影」。
         可读性交给卡片自身的半透明底，不再靠整屏蒙版。 -->

    <!-- Main WebView -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 手势条区域补色条。
         WebView 为了让出系统栏用了 bottomMargin，所以它根本没画到手势条那段，
         CSS 里的 .pk-mask / .modal-bg 也就盖不到那里：打开周次选择或课程详情时，
         屏幕最下面会留一条没被压暗的照片，看着像遮罩缺了一块。
         这条 View 正好补在那段高度上（运行时按 navigationBarInset 设置），
         颜色由 JS 按当前浮层状态通过 setBottomShade 指定：
           0=透明（没有浮层，照片原样透出来）
           1=黑 42%（与 .modal-bg 的 scrim 同色）
           2=页面底色（与底部面板 .pk-sheet 同色，面板开到底时接得上）
         不设 clickable，触摸会继续向下派发，不挡 WebView 的手势。 -->
    <View
        android:id="@+id/bottomShade"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="bottom"
        android:visibility="gone" />

    <!-- Loading overlay -->
    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#F5F5F7"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="#667eea" />

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/loading"
            android:textColor="#667eea"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Error overlay -->
    <LinearLayout
        android:id="@+id/errorOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#F5F5F7"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_load"
            android:textColor="#555"
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/retry"
            android:backgroundTint="#667eea"
            android:textColor="#FFFFFF"
            android:paddingStart="32dp"
            android:paddingEnd="32dp" />
    </LinearLayout>

    <!-- Splash 开屏（置顶）。
         clickable/focusable 必须为 true：FrameLayout 里不可点击的子 View 不消费触摸，
         事件会继续派发给下层 WebView —— 开屏期间点一下会命中课程卡片、左右滑会切周。
         这也是「开屏动画看起来被打断 / 课表自己动了」的来源。 -->
    <LinearLayout
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="#FFFFFF">

        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:src="@drawable/ic_launcher_foreground"
            android:contentDescription="石大课表Logo" />

        <ImageView
            android:id="@+id/splashTitle"
            android:layout_width="280dp"
            android:layout_height="118dp"
            android:layout_marginTop="32dp"
            android:src="@drawable/splash_title"
            android:contentDescription="石大课表"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/splashSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="SHZU SCHEDULE"
            android:textColor="#999999"
            android:textSize="12sp"
            android:letterSpacing="0.3" />
    </LinearLayout>

</FrameLayout>
