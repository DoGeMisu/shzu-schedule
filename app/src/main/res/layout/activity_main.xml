<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- 自定义背景图（最底层，切周重载页面时不会闪白） -->
    <ImageView
        android:id="@+id/bgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- 顶部渐变遮罩：有背景图时盖一条很轻的渐变，否则状态栏的时间/信号
         压在照片上几乎看不见。放在 WebView 之下，页面文字也能借到这层对比度。 -->
    <View
        android:id="@+id/topScrim"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:visibility="gone" />

    <!-- Main WebView -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Loading overlay -->
    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#F5F5F7"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="#667eea" />

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/loading"
            android:textColor="#667eea"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Error overlay -->
    <LinearLayout
        android:id="@+id/errorOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#F5F5F7"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_load"
            android:textColor="#555"
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/retry"
            android:backgroundTint="#667eea"
            android:textColor="#FFFFFF"
            android:paddingStart="32dp"
            android:paddingEnd="32dp" />
    </LinearLayout>

    <!-- Splash 开屏（置顶）。
         clickable/focusable 必须为 true：FrameLayout 里不可点击的子 View 不消费触摸，
         事件会继续派发给下层 WebView —— 开屏期间点一下会命中课程卡片、左右滑会切周。
         这也是「开屏动画看起来被打断 / 课表自己动了」的来源。 -->
    <LinearLayout
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="#FFFFFF">

        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:src="@drawable/ic_launcher_foreground"
            android:contentDescription="石大课表Logo" />

        <ImageView
            android:id="@+id/splashTitle"
            android:layout_width="280dp"
            android:layout_height="118dp"
            android:layout_marginTop="32dp"
            android:src="@drawable/splash_title"
            android:contentDescription="石大课表"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/splashSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="SHZU SCHEDULE"
            android:textColor="#999999"
            android:textSize="12sp"
            android:letterSpacing="0.3" />
    </LinearLayout>

</FrameLayout>
